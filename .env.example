# Telegram bot token from BotFather
TOKEN=put_your_telegram_bot_token_here
# Public HTTPS URL of your Render web service
BASE_URL=https://your-service.onrender.com
WEB_APP_URL=https://your-service.onrender.com
APP_NAME=LinkShotnerPro
# Optional admin protection for link creation; leave blank to disable
ADMIN_TOKEN=
# Recommended for persistent links: PostgreSQL connection URL from Render
# DATABASE_URL=postgresql://user:password@host:5432/database
# If DATABASE_URL is blank, local SQLite is used (may reset on ephemeral hosts)
